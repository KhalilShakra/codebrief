<Window x:Class="CodeBrief.Desktop.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Licens — CodeBrief"
        Height="400"
        Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{StaticResource TextBrush}"
        ResizeMode="NoResize">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource AccentBrush}"/>

        <Border DockPanel.Dock="Bottom" Padding="24,16" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0" Background="{StaticResource HeaderBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Stäng" Style="{StaticResource GhostButton}" IsCancel="True" MinWidth="88" Click="OnClose"/>
                <Button Content="Aktivera" Style="{StaticResource PrimaryButton}" MinWidth="88" Margin="8,0,0,0" Padding="16,6" Click="OnActivate"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource DialogTitle}" Text="Licens"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" Margin="0,0,0,20" TextWrapping="Wrap"/>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Klistra in din CodeBrief-nyckel (börjar med CB1.)"/>
                    <TextBox x:Name="KeyBox"
                             Height="112"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="12.5"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
