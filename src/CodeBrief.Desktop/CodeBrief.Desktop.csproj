<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodeBrief.Contracts\CodeBrief.Contracts.csproj" />
    <ProjectReference Include="..\CodeBrief.Core\CodeBrief.Core.csproj" />
    <ProjectReference Include="..\CodeBrief.Licensing\CodeBrief.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CodeBrief</AssemblyName>
    <RootNamespace>CodeBrief.Desktop</RootNamespace>
    <Product>CodeBrief</Product>
    <Version>1.0.0</Version>
    <Description>Skrivbordsapp som analyserar källkod och genererar pedagogiska rapporter.</Description>
    <ApplicationTitle>CodeBrief</ApplicationTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
