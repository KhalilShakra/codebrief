<Window x:Class="CodeBrief.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inställningar — CodeBrief"
        Height="520"
        Width="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{StaticResource TextBrush}"
        ResizeMode="NoResize">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource AccentBrush}"/>

        <Border DockPanel.Dock="Bottom" Padding="24,16" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0" Background="{StaticResource HeaderBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Avbryt" Style="{StaticResource GhostButton}" IsCancel="True" MinWidth="88" Click="OnCancel"/>
                <Button Content="Spara" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="88" Margin="8,0,0,0" Padding="16,6" Click="OnSave"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <TextBlock Style="{StaticResource DialogTitle}" Text="Analysmotor"/>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,24"
                           Text="Utan API-nyckel används alltid den lokala motorn. Nyckeln lagras krypterad för ditt Windows-konto."/>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Provider"/>
                        <ComboBox x:Name="ProviderBox" Margin="0,0,0,16">
                            <ComboBoxItem Content="Lokal heuristik" Tag="Local"/>
                            <ComboBoxItem Content="OpenAI" Tag="OpenAI"/>
                            <ComboBoxItem Content="Anthropic" Tag="Anthropic"/>
                        </ComboBox>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="API-nyckel"/>
                        <PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,16"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="OpenAI-modell"/>
                        <TextBox x:Name="OpenAiModelBox" Margin="0,0,0,16"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Anthropic-modell"/>
                        <TextBox x:Name="AnthropicModelBox"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
