<UserControl x:Class="CodeBrief.Desktop.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CodeBrief.Contracts;assembly=CodeBrief.Contracts">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type c:Finding}">
            <Border Margin="0,0,0,8" Background="#1C2330" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="2" Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Severity}"
                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                       FontSize="11" Margin="8,0,0,0"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,12,0">
        <StackPanel>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="1. Språk och miljö"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Language.Complexity, Converter={StaticResource ComplexityLabel}}"
                                   Foreground="{StaticResource AccentBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Language.Name}" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Language.Frameworks}" Margin="0,6,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#243044" CornerRadius="10" Padding="8,3" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Overview.Summary}" Style="{StaticResource BodyText}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="2. Pseudokod"/>
                    <Border Background="#0B0E13" CornerRadius="6" Padding="12">
                        <ItemsControl ItemsSource="{Binding Pseudocode.Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Code, Consolas" FontSize="12.5"
                                               Foreground="#C9D1D9" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="3. Kodflöde"/>
                    <TextBlock Text="Indata" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Flow.Inputs}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Steg" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Flow.Steps}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Utdata" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Flow.Outputs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="4. Buggar, fel och säkerhet"/>
                    <Border Background="#10251C" CornerRadius="6" Padding="10" Margin="0,0,0,10"
                            Visibility="{Binding Issues.IsCorrect, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Koden ser korrekt ut enligt den lokala analysen. Inga kritiska fel flaggades."
                                   Foreground="{StaticResource OkBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Buggar" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Inga buggar hittades." Style="{StaticResource BodyText}" Margin="0,0,0,8"
                               Visibility="{Binding Issues.Bugs.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Issues.Bugs}" Margin="0,0,0,10"
                                  Visibility="{Binding Issues.Bugs.Count, Converter={StaticResource CountToVis}}"/>

                    <TextBlock Text="Kantfall" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Inga kantfall flaggades." Style="{StaticResource BodyText}" Margin="0,0,0,8"
                               Visibility="{Binding Issues.EdgeCases.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Issues.EdgeCases}" Margin="0,0,0,10"
                                  Visibility="{Binding Issues.EdgeCases.Count, Converter={StaticResource CountToVis}}"/>

                    <TextBlock Text="Säkerhet" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Inga säkerhetsrisker flaggades." Style="{StaticResource BodyText}"
                               Visibility="{Binding Issues.Security.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Issues.Security}"
                                  Visibility="{Binding Issues.Security.Count, Converter={StaticResource CountToVis}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="5. Prestanda och best practices"/>
                    <TextBlock Text="Prestanda" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Improvements.Performance}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Underhåll" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Improvements.Maintainability}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="6. Korrigerad kod"/>
                    <TextBlock Text="{Binding Fix.Explanation}" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                    <Border Background="#0B0E13" CornerRadius="6" Padding="12"
                            Visibility="{Binding Fix.CorrectedCode, Converter={StaticResource NullToVis}}">
                        <TextBox Text="{Binding Fix.CorrectedCode, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 FontFamily="Cascadia Code, Consolas"
                                 FontSize="12.5"
                                 Foreground="#C9D1D9"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 MaxHeight="280"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
